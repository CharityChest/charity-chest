# Copy to .env in this same directory — docker-compose reads it automatically.
# .env is git-ignored and must NEVER be committed.
#
# These variables are the only ones without safe defaults baked into
# docker-compose.yml. Every entry below is REQUIRED unless explicitly marked
# optional. Bringing the stack up with any required value missing produces a
# clear "Set <VAR> in .compose/.env" error from docker-compose.

# ── Admin backend ────────────────────────────────────────────────────────────

# Google OAuth credentials (browser flow on the admin webapp).
# Create an OAuth 2.0 Client ID of type "Web application" in Google Cloud
# Console and register http://localhost:8080/v1/auth/google/callback as an
# authorised redirect URI.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# First root user seeded by services/admin/backend/cmd/seed-root on first boot.
ROOT_USER=root@example.com
ROOT_PASSWORD=change-me-now

# ── Operational backend ─────────────────────────────────────────────────────

# Shared service-to-service secret. Used as a constant-time-compared metadata
# entry (`x-service-key`) on every gRPC call the operational backend sends to
# the admin AdminInternal service. Generate with:
#     openssl rand -hex 32
# The SAME value must be configured on both admin and operational containers
# (docker-compose passes it to both from this single entry).
SERVICE_API_KEY=

# Google Cloud Console OAuth client ID(s) — audience(s) validated by
# operational on every POST /v1/auth/google from the mobile app. The app uses a
# per-platform OAuth client, so a forwarded ID token's `aud` may be the iOS,
# Android, or Web client ID; list all of them comma-separated and any match is
# accepted. A single value (just the Web client ID) also works.
GOOGLE_AUDIENCE=your-ios-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com,your-web-client-id.apps.googleusercontent.com

# ── Admin frontend (optional) ───────────────────────────────────────────────

# Base URL of the admin API as seen from the browser. Defaults to
# http://localhost:8080 (the host-mapped port of admin-backend) which is what
# you want for the standard local-dev case. Override only when running the
# frontend container against a remote admin instance.
#NEXT_PUBLIC_API_URL=http://localhost:8080

# ── Stripe (optional) ───────────────────────────────────────────────────────
# Leave blank to run without billing (admin's billing endpoints return 503).
# To exercise checkout/webhooks locally, use Stripe test-mode keys and the
# secret printed by `stripe listen --forward-to localhost:8080/stripe/webhook`.
# When STRIPE_SECRET_KEY is set, the other two are required by config.Load().
#STRIPE_SECRET_KEY=
#STRIPE_WEBHOOK_SECRET=
#STRIPE_PRO_PRICE_ID=
