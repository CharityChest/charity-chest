# Copy this file to .env and fill in your values.
# .env is git-ignored and must NEVER be committed.

# Deployment environment — one of: local, testing, staging, production.
# The server refuses to start with any other value.
APP_ENV=local

# HTTP listen port.
PORT=8081

# PostgreSQL connection string.
# The operational backend has no user/identity tables in v1; this DB is here
# for future operational-owned entities. Migrations run on startup regardless.
DATABASE_URL=postgres://user:password@localhost:5432/charitychest_op?sslmode=disable

# HS256 signing secret for the operational backend's JWTs. Independent from
# admin's JWT_SECRET on purpose — a compromise here cannot forge admin tokens.
# Use a long, random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=replace-with-a-long-random-secret

# Admin backend base URL. The operational backend calls /v1/internal/* on it.
ADMIN_BASE_URL=http://localhost:8080

# Service-to-service shared secret. Must match SERVICE_API_KEY on the admin
# backend, otherwise every login fails with 502. Generate with
# `openssl rand -hex 32`.
SERVICE_API_KEY=

# Google OAuth client ID validated as the `aud` claim on Google ID tokens the
# mobile app forwards in POST /v1/auth/google. Typically the *Web* client ID
# from Google Cloud Console (the one shared by all platforms as the audience).
GOOGLE_AUDIENCE=your-web-client-id.apps.googleusercontent.com

# Optional: per-request access log middleware. Set to "false" to silence it.
REQUEST_LOG_ENABLED=true

# Optional: comma-separated list of browser origins allowed by CORS. Defaults
# to http://localhost:3000 for local dev. Set the real web origin(s) in
# staging/production — never "*".
ALLOWED_ORIGINS=http://localhost:3000

# Optional: timeout applied to every admin call. Surfaced as 502 on the public
# API when admin doesn't respond within this window.
ADMIN_TIMEOUT=10s

# Cache (Valkey/Redis-compatible). Unused in v1 — wired up so future endpoints
# can read/write without re-bootstrapping.
CACHE_ENABLED=false
CACHE_URL=redis://localhost:6379
CACHE_TTL=5m
