# Copy to .env. Required when bringing up the operational dev compose.
# Both values below MUST also be set on the admin compose at
# services/admin/backend/.docker-dev/.env (SERVICE_API_KEY identical).

# Shared service-to-service secret. Generate with `openssl rand -hex 32`.
SERVICE_API_KEY=

# Google Cloud Console OAuth client ID(s) — audience(s) validated by
# operational on every POST /v1/auth/google. Comma-separate the iOS, Android,
# and Web client IDs (the app uses one per platform); any match is accepted.
GOOGLE_AUDIENCE=your-ios-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com,your-web-client-id.apps.googleusercontent.com
