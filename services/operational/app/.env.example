# Copy to .env.local (Expo loads EXPO_PUBLIC_* from .env / .env.local / etc.).
# These names are public — anything baked into the binary at build time.

# Operational backend URL. From iOS Simulator use http://localhost:8081; from
# Android emulator use http://10.0.2.2:8081 (the loopback of the host).
EXPO_PUBLIC_API_URL=http://localhost:8081

# Google Cloud Console OAuth client IDs.
# Create three OAuth clients (iOS, Android, Web) under the same project; the
# operational backend validates against the Web client ID — set it as
# GOOGLE_AUDIENCE on the backend so the audiences agree.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
