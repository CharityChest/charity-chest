BINARY  := server
DEBUG   := dist/debug/$(BINARY)
RELEASE := dist/release/$(BINARY)

# golang-migrate is already in go.mod — no separate install needed.
MIGRATE      := go run -tags 'postgres' github.com/golang-migrate/migrate/v4/cmd/migrate
GOLANGCI_LINT := go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.11.4

# Keep these in sync with the corresponding entries in go.mod so the generator
# and the linked runtime package cannot drift.
TEMPL_VERSION              := v0.3.1020
TEMPL                      := go run github.com/a-h/templ/cmd/templ@$(TEMPL_VERSION)
PROTOC_GEN_GO_VERSION      := v1.36.11
PROTOC_GEN_GO_GRPC_VERSION := v1.6.2

.PHONY: all build build-debug build-release test test-coverage lint fmt clean tidy seed-root migrate migrate-down migrate-version templ proto setup-hooks

# ── Default ───────────────────────────────────────────────────────────────────

all: build

build: build-debug build-release

# ── Debug build ───────────────────────────────────────────────────────────────
# Optimisations and inlining are disabled so the binary is debugger-friendly.
# The race detector is enabled to catch data races during development.
# `templ` and `proto` run first so all generated files are in sync with their
# sources before the compiler reads them.

build-debug: templ proto
	@mkdir -p dist/debug
	go build \
	  -race \
	  -gcflags="all=-N -l" \
	  -o $(DEBUG) \
	  .
	@echo "debug binary → $(DEBUG)"

# ── Release build ─────────────────────────────────────────────────────────────
# Produces a fully static binary with debug info and symbol table stripped.
# `templ` and `proto` run first so the binary cannot ship stale generated files.

build-release: templ proto
	@mkdir -p dist/release
	CGO_ENABLED=0 GOOS=linux go build \
	  -ldflags="-s -w" \
	  -o $(RELEASE) \
	  .
	@echo "release binary → $(RELEASE)"

# ── Helpers ───────────────────────────────────────────────────────────────────

# One-time per-clone bootstrap: point git at the in-repo hooks directory
# (.githooks/ at the repo root) so the read-only guards and golangci-lint
# pre-commit hook run. The relative path is resolved against the worktree root
# at hook time, so it is correct regardless of where git is invoked from.
setup-hooks:
	git config core.hooksPath .githooks
	@echo "git hooks enabled → .githooks (core.hooksPath)"

test:
	@docker info >/dev/null 2>&1 || (echo "ERROR: Docker daemon required for tests (testcontainers boots a Postgres container)"; exit 1)
	go test -race ./internal/...

# Report coverage across all production packages, excluding files that cannot
# carry meaningful coverage:
#   - main.go and cmd/* are thin entry points exercised only end-to-end;
#   - *_templ.go is generated by templ — its statements are tied to the
#     template source, not to logic we can usefully unit-test.
#   - *.pb.go are generated gRPC/protobuf bindings — not hand-written logic.
# `-coverpkg=./...` cross-instruments every package so coverage triggered by
# integration tests in routes/v1 counts against the file that owns the code.
# The result is `coverage.business.out`; the raw report is `coverage.out`.
test-coverage:
	@docker info >/dev/null 2>&1 || (echo "ERROR: Docker daemon required for tests (testcontainers boots a Postgres container)"; exit 1)
	go test -race -coverpkg=./... -coverprofile=coverage.out ./...
	@grep -v -E '(charity-chest/services/admin/backend/main\.go|charity-chest/services/admin/backend/cmd/|_templ\.go|\.pb\.go)' coverage.out > coverage.business.out
	@echo "── full coverage ──"
	@go tool cover -func=coverage.out | tail -1
	@echo "── coverage excluding entry points and generated code ──"
	@go tool cover -func=coverage.business.out | tail -1

lint:
	$(GOLANGCI_LINT) run ./...

fmt:
	gofmt -w .
	$(GOLANGCI_LINT) run --fix ./...

tidy:
	go mod tidy

# Regenerate the *_templ.go files from .templ sources. Commit both the .templ
# and the generated *_templ.go file — the generated file is checked in so
# `go build` works without a separate codegen step.
templ:
	$(TEMPL) generate

# Regenerate protobuf + gRPC Go bindings from proto/admin/internal/v1/internal.proto.
# Installs the two Go plugins pinned to the versions above, then runs protoc.
# Requires protoc in PATH — install via your package manager or
# https://grpc.io/docs/protoc-installation/. Both the .proto source and the
# generated *pb.go files are checked in so `go build` works without a
# separate codegen step.
# Also syncs the proto copy used by the operational backend at runtime.
proto:
	go install google.golang.org/protobuf/cmd/protoc-gen-go@$(PROTOC_GEN_GO_VERSION)
	go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@$(PROTOC_GEN_GO_GRPC_VERSION)
	protoc \
	  --proto_path=proto \
	  --go_out=. \
	  --go_opt=module=charity-chest/services/admin/backend \
	  --go-grpc_out=. \
	  --go-grpc_opt=module=charity-chest/services/admin/backend \
	  admin/internal/v1/internal.proto
	@if [ -d "../../operational/backend/src/adminclient" ]; then \
	    cp proto/admin/internal/v1/internal.proto \
	       ../../operational/backend/src/adminclient/internal.proto && \
	    echo "proto: synced → services/operational/backend/src/adminclient/internal.proto"; \
	fi

clean:
	rm -rf dist

# ── Seed ──────────────────────────────────────────────────────────────────────
# Creates a root user in the database.
# Usage: make seed-root EMAIL=admin@example.com PASSWORD=secret

seed-root:
	@test -n "$(EMAIL)"    || (echo "ERROR: EMAIL is required";    exit 1)
	@test -n "$(PASSWORD)" || (echo "ERROR: PASSWORD is required"; exit 1)
	SEED_ROOT_EMAIL=$(EMAIL) SEED_ROOT_PASSWORD=$(PASSWORD) \
	  go run ./cmd/seed-root/main.go -migrations migrations

# ── Migrations ────────────────────────────────────────────────────────────────
# DATABASE_URL must be set in the environment or .env.

# Apply all pending migrations.
migrate:
	@test -n "$(DATABASE_URL)" || (echo "ERROR: DATABASE_URL is required"; exit 1)
	$(MIGRATE) -path migrations -database "$(DATABASE_URL)" up

# Roll back N migration steps.
# Usage: make migrate-down N=1
migrate-down:
	@test -n "$(DATABASE_URL)" || (echo "ERROR: DATABASE_URL is required"; exit 1)
	@test -n "$(N)" || (echo "ERROR: N is required (e.g. make migrate-down N=1)"; exit 1)
	$(MIGRATE) -path migrations -database "$(DATABASE_URL)" down $(N)

# Print the current migration version.
migrate-version:
	@test -n "$(DATABASE_URL)" || (echo "ERROR: DATABASE_URL is required"; exit 1)
	$(MIGRATE) -path migrations -database "$(DATABASE_URL)" version