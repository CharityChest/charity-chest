# Copy this file to .env (same directory) — docker-compose reads it automatically.
# These are the only secrets that cannot be given a safe demo default.

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
ROOT_PASSWORD=
ROOT_USER=

# Stripe (billing) — optional. Leave blank to run without billing (endpoints
# return 503). To test checkout/webhooks locally, use Stripe test-mode keys and
# the secret printed by `stripe listen --forward-to localhost:8080/stripe/webhook`.
# If STRIPE_SECRET_KEY is set, the other two must be too.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=